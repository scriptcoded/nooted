{
  "name": "nooted",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @nooted/sdk build:loader && pnpm --parallel --filter './apps/*' --filter @nooted/sdk dev",
    "build": "pnpm --filter @nooted/sdk build:loader && pnpm -r build",
    "typecheck": "pnpm --filter @nooted/sdk build:loader && pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
